{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "sourceMap": true,
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "noEmit": true,
    "types": ["vite/client", "node", "ant-design-vue/typings/global"],
    "paths": {
      "@/*": ["src/*"],
      "@build/*": ["build/*"]
    },
    "allowJs": true,
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/auto-import.d.ts",
    "src/components/components.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
